# ==============================================================================
# KAPMETA / PETPOOJA POS & OPERATIONS PLATFORM — ENVIRONMENT EXAMPLE TEMPLATE
# ==============================================================================

# Application Environment
NODE_ENV=development
LOG_LEVEL=debug

# Fixed Ports Configuration
PORT=4444
APP_PORT=4444
POS_PORT=4444
API_PORT=4001
ADMIN_PORT=4445
DB_PORT=5432
REDIS_PORT=6379

# PostgreSQL Database (Primary Persistence)
DATABASE_URL=postgresql://pos:pos@localhost:5432/petpooja
DATABASE_POOL_MAX=20

# Redis Cache & PubSub
REDIS_URL=redis://localhost:6379

# Message Queue (RabbitMQ / Event Broker)
QUEUE_URL=amqp://localhost:5672

# Object Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pos-documents
S3_ACCESS_KEY=dev_access_key
S3_SECRET_KEY=dev_secret_key

# JWT Authentication & Security
JWT_SECRET=dev_jwt_secret_key_minimum_32_characters_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CREDENTIALS_ENCRYPTION_KEY=dev_only_channel_credentials_key_change_in_prod

# Online Aggregators & Integration Hub
SWIGGY_API_BASE=https://api.swiggy.com
SWIGGY_CLIENT_ID=
SWIGGY_CLIENT_SECRET=
SWIGGY_WEBHOOK_SECRET=
ZOMATO_API_BASE=https://api.zomato.com
ZOMATO_CLIENT_ID=
ZOMATO_CLIENT_SECRET=
ZOMATO_WEBHOOK_SECRET=

# Payment Gateway
PAYMENT_GATEWAY=razorpay
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# OpenTelemetry & Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
