generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String?    @unique @db.Citext
  phone        String?
  firstName    String?    @map("first_name")
  lastName     String?    @map("last_name")
  passwordHash String     @map("password_hash")
  pinHash      String?    @map("pin_hash")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?    @map("created_by") @db.Uuid
  updatedBy    String?    @map("updated_by") @db.Uuid
  userRoles     UserRole[]
  sessions      Session[]
  quickLinks    UserQuickLink[]
  notifications Notification[]
  physicalMenuFiles PhysicalMenuFile[]

  @@map("users")
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()"))
  name            String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")
  createdBy       String?          @map("created_by")
  updatedBy       String?          @map("updated_by")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()"))
  action          String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  outletId   String?  @map("outlet_id")
  user       User     @relation(fields: [userId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])
  outlet     Outlet?  @relation(fields: [outletId], references: [id])

  @@id([userId, roleId])
  @@index([outletId], map: "idx_user_roles_outlet")
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  outletId           String?   @map("outlet_id") @db.Uuid
  tokenHash          String?   @unique @map("token_hash")
  ipAddress          String?   @map("ip_address") @db.Inet
  userAgent          String?   @map("user_agent")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User      @relation(fields: [userId], references: [id])

  @@map("sessions")
}

model AuditLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  outletId       String    @map("outlet_id")
  userId         String    @map("user_id")
  action         String    @map("action")
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  beforeState    Json?     @map("before_state")
  afterState     Json?     @map("after_state")
  reasonCode     String?   @map("reason_code")
  approverUserId String?   @map("approver_user_id")
  ipAddress      String?   @map("ip_address")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([outletId], map: "idx_audit_logs_outlet")
  @@index([entityId], map: "idx_audit_logs_entity")
  @@map("audit_logs")
}

model Organization {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  name       String
  taxNumber  String?  @map("tax_number")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")

  @@map("organizations")
}

model Outlet {
  id             String     @id @default(dbgenerated("gen_random_uuid()"))
  organizationId String     @map("organization_id")
  code           String
  name           String
  address        String?
  phone          String?
  email          String?
  logoUrl        String?    @map("logo_url")
  fssaiNumber    String?    @map("fssai_number")
  upiVpa         String?    @map("upi_vpa")
  timezone       String     @default("Asia/Kolkata")
  currency       String     @default("INR")
  dayStartTime   String?    @map("day_start_time")
  isActive       Boolean    @default(true) @map("is_active")
  lastMenuSyncAt DateTime?  @map("last_menu_sync_at")
  isVirtual      Boolean    @default(false) @map("is_virtual")
  parentOutletId String?    @map("parent_outlet_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at")
  createdBy      String?    @map("created_by")
  updatedBy      String?    @map("updated_by")
  userRoles      UserRole[]
  parentOutlet   Outlet?    @relation("OutletVirtualChildren", fields: [parentOutletId], references: [id])
  virtualOutlets Outlet[]   @relation("OutletVirtualChildren")

  @@map("outlets")
}

model Station {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId          String      @map("outlet_id") @db.Uuid
  name              String
  printerIp         String?     @map("printer_ip")
  slaWarningSeconds Int?        @default(300) @map("sla_warning_seconds")
  slaBreachSeconds  Int?        @default(600) @map("sla_breach_seconds")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?     @map("created_by") @db.Uuid
  updatedBy         String?     @map("updated_by") @db.Uuid
  kotTickets        KOTTicket[]

  @@index([outletId], map: "idx_stations_outlet")
  @@map("stations")
}

model MenuCategory {
  id                 String     @id @default(dbgenerated("gen_random_uuid()"))
  outletId           String     @map("outlet_id")
  name               String
  description        String?
  sortOrder          Int        @default(0) @map("sort_order")
  isActive           Boolean    @default(true) @map("is_active")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  menuItems          MenuItem[]

  @@unique([outletId, name], map: "ux_menu_categories_outlet_name")
  @@index([outletId], map: "ix_menu_categories_outlet_id")
  @@map("menu_categories")
}

model DiningTable {
  id                   String   @id @default(dbgenerated("gen_random_uuid()"))
  outletId             String   @map("outlet_id")
  tableNumber          String   @map("table_number")
  capacity             Int      @default(4)
  section              String   @default("General")
  status               String   @default("VACANT")
  isActive             Boolean  @default(true) @map("is_active")
  mergeGroupId         String?  @map("merge_group_id") @db.Uuid
  mergePrimaryTableId  String?  @map("merge_primary_table_id") @db.Uuid
  version              Int      @default(1)
  covers               Int?
  isAirConditioned     Boolean? @map("is_air_conditioned")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  orders               Order[]

  @@unique([outletId, tableNumber], map: "uq_dining_tables_outlet_number")
  @@index([outletId], map: "idx_dining_tables_outlet")
  @@index([mergeGroupId], map: "idx_dining_tables_merge_group")
  @@map("dining_tables")
}

model areas {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outlet_id  String   @db.Uuid
  name       String
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([outlet_id, name], map: "areas_outlet_id_name_key")
  @@index([outlet_id], map: "idx_areas_outlet")
}

model table_merge_groups {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outlet_id         String              @db.Uuid
  primary_table_id  String              @db.Uuid
  status            table_merge_status  @default(ACTIVE)
  total_capacity    Int?
  covers            Int?
  opened_at         DateTime            @default(now()) @db.Timestamptz(6)
  closed_at         DateTime?           @db.Timestamptz(6)
  created_by        String?             @db.Uuid
  reason            String?

  @@index([outlet_id], map: "idx_table_merge_groups_outlet")
  @@index([primary_table_id], map: "idx_table_merge_groups_primary_table")
  @@map("table_merge_groups")
}

model table_merge_members {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outlet_id        String    @db.Uuid
  merge_group_id   String    @db.Uuid
  dining_table_id  String    @db.Uuid
  is_primary       Boolean   @default(false)
  joined_at        DateTime  @default(now()) @db.Timestamptz(6)
  left_at          DateTime? @db.Timestamptz(6)

  @@index([outlet_id], map: "idx_table_merge_members_outlet")
  @@index([merge_group_id], map: "idx_table_merge_members_group")
  @@index([dining_table_id], map: "idx_table_merge_members_table")
  @@map("table_merge_members")
}

model table_seats {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outlet_id        String      @db.Uuid
  dining_table_id  String      @db.Uuid
  seat_number      Int
  label            String?
  status           seat_status @default(EMPTY)
  guest_name       String?

  @@unique([outlet_id, dining_table_id, seat_number], map: "uq_table_seats_outlet_table_seat")
  @@index([outlet_id], map: "idx_table_seats_outlet")
  @@index([dining_table_id], map: "idx_table_seats_table")
  @@map("table_seats")
}

model order_seat_bills {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outlet_id             String    @db.Uuid
  order_id              String    @db.Uuid
  seat_number           Int
  split_group_id        String?   @db.Uuid
  subtotal              BigInt    @default(0)
  discount_total        BigInt    @default(0)
  tax_total              BigInt    @default(0)
  service_charge_total  BigInt    @default(0)
  tip_total             BigInt    @default(0)
  grand_total           BigInt    @default(0)
  paid_total            BigInt    @default(0)
  status                String    @default("OPEN")
  settled_at            DateTime? @db.Timestamptz(6)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([outlet_id, order_id, seat_number], map: "uq_order_seat_bills_outlet_order_seat")
  @@index([outlet_id], map: "idx_order_seat_bills_outlet")
  @@index([order_id], map: "idx_order_seat_bills_order")
  @@map("order_seat_bills")
}

model order_item_seat_shares {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outlet_id           String  @db.Uuid
  order_item_id       String  @db.Uuid
  seat_number         Int
  share_numerator     Int
  share_denominator   Int
  allocated_subtotal  BigInt  @default(0)

  @@unique([order_item_id, seat_number], map: "uq_order_item_seat_shares_item_seat")
  @@index([outlet_id], map: "idx_order_item_seat_shares_outlet")
  @@index([order_item_id], map: "idx_order_item_seat_shares_order_item")
  @@map("order_item_seat_shares")
}

model table_operation_idempotency {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outlet_id       String   @db.Uuid
  idempotency_key String
  endpoint        String
  response_json   Json
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([outlet_id, endpoint, idempotency_key], map: "uq_table_operation_idempotency_key")
  @@map("table_operation_idempotency")
}

model UserQuickLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String
  href      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_user_quick_links_user")
  @@map("user_quick_links")
}

model MenuItem {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId          String        @map("outlet_id") @db.Uuid
  categoryId        String        @map("category_id") @db.Uuid
  name              String
  description       String?
  price             BigInt?       @default(0) @map("price")
  taxRate           Decimal?      @default(5.00) @map("tax_rate") @db.Decimal(5, 2)
  isVeg             Boolean       @default(true) @map("is_veg")
  isActive          Boolean       @default(true) @map("is_active")
  station_id        String?       @map("station_id") @db.Uuid
  onlineDisplayName String?       @map("online_display_name")
  shortCode         String?       @map("short_code")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category          MenuCategory? @relation(fields: [categoryId], references: [id])
  kotItems          KOTItem[]
  orderItems        OrderItem[]
  itemCommissions   ItemCommission[]
