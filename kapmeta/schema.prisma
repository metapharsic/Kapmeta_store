  actualCashCountedMinor BigInt   @map("actual_cash_counted_minor")
  openingFloatMinor      BigInt   @map("opening_float_minor")
  netTipPayoutMinor      BigInt   @map("net_tip_payout_minor")
  digitalTipsMinor       BigInt   @default(0) @map("digital_tips_minor")
  serviceChargeMinor     BigInt   @default(0) @map("service_charge_minor")
  cashSalesMinor         BigInt   @default(0) @map("cash_sales_minor")
  managerNotes           String?  @map("manager_notes")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([outletId, businessDate], map: "idx_waiter_shift_handovers_outlet_date")
  @@index([waiterId], map: "idx_waiter_shift_handovers_waiter")
