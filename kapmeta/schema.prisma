model Order {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId            String       @map("outlet_id") @db.Uuid
  terminalNumber      String?      @map("terminal_number")
  orderNumber         String       @map("order_number")
  orderType           String       @default("DINE_IN") @map("order_type")
  diningTableId       String?      @map("dining_table_id") @db.Uuid
  status              String       @default("DRAFT")
  subtotal            BigInt       @default(0) @map("subtotal")
  discountTotal       BigInt?      @default(0) @map("discount_total")
  taxTotal            BigInt?      @default(0) @map("tax_total")
  grandTotal          BigInt       @default(0) @map("grand_total")
  idempotencyKey      String?      @map("idempotency_key")
  customerId          String?      @map("customer_id") @db.Uuid
  waiterId            String?      @map("waiter_id") @db.Uuid
  serviceChargeTotal  BigInt       @default(0) @map("service_charge_total")
  tipTotal            BigInt       @default(0) @map("tip_total")
  mergeGroupId        String?      @map("merge_group_id") @db.Uuid
