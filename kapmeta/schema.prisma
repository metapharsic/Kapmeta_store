}

model OrderItemModifier {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outlet_id         String   @db.Uuid
  orderItemId       String   @map("order_item_id") @db.Uuid
  modifier_id       String   @db.Uuid
  modifier_name     String
  price_delta_minor BigInt   @default(0)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
  created_by        String?  @db.Uuid
  updated_by        String?  @db.Uuid

  @@index([modifier_id], map: "idx_order_item_modifiers_modifier")
  @@index([orderItemId], map: "idx_order_item_modifiers_order_item")
  @@index([outlet_id], map: "idx_order_item_modifiers_outlet")
  @@map("order_item_modifiers")
}

model OrderStatusHistory {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  outletId    String   @map("outlet_id")
  orderId     String   @map("order_id")
  status      String   @map("status")
  notes       String?  @map("notes")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId], map: "idx_order_status_history_order")
  @@index([outletId], map: "idx_order_status_history_outlet")
  @@map("order_status_history")
}

/// KOT ticket lifecycle.
///
/// `status` is an untyped String and stays that way: the underlying column is
/// free-text, the KDS and the table-view aggregator both write it directly, and
/// several legacy aliases are still tolerated on read (see below). Converting it
/// to a Prisma enum would reject rows that already exist. This block is the
/// canonical value set instead.
///
/// Canonical values written by this system:
///
///   QUEUED     ticket created, not yet picked up by the kitchen
///   PREPARING  kitchen has started the ticket
///   READY      food is up, not yet delivered
///   SERVED     delivered to the table
///   CANCELLED  ticket voided before completion
///
/// Aliases still accepted on read (apps/api/src/routes/tables.ts):
///   QUEUED    <- KOT_CREATED, PENDING
///   PREPARING <- IN_PREPARATION, COOKING
///
/// Mapping to the reference UI's KOT status labels:
///
///   Reference label   Canonical value
///   ---------------   ---------------
///   Not Prepared      QUEUED
///   Preparing         PREPARING
///   Active            READY
///   Used In Bill      SERVED, with billPrintedAt non-null
///   Cancelled         CANCELLED
///
/// "Used In Bill" is not a status of its own: it is SERVED plus the fact that a
/// bill has been printed for the ticket. Those are two independent facts, which
/// is why bill_printed_at is its own column (migration 0039) rather than another
/// status value.
model KOTTicket {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId      String             @map("outlet_id") @db.Uuid
  orderId       String             @map("order_id") @db.Uuid
  stationId     String?            @map("station_id") @db.Uuid
  ticketNumber  String             @map("ticket_number")
  status        String
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  servedAt      DateTime?          @map("served_at") @db.Timestamptz(6)
  billPrintedAt DateTime?          @map("bill_printed_at") @db.Timestamptz(6)
  order         Order?             @relation(fields: [orderId], references: [id])
  station       Station?           @relation(fields: [stationId], references: [id])
  kotItems      KOTItem[]
  statusHistory KOTStatusHistory[]

  @@index([orderId], map: "idx_kot_tickets_order")
  @@index([outletId], map: "idx_kot_tickets_outlet")
  @@index([stationId], map: "idx_kot_tickets_station")
  @@map("kot_tickets")
}

model KOTItem {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outletId    String     @map("outlet_id") @db.Uuid
  kotTicketId String     @map("kot_ticket_id") @db.Uuid
  menuItemId  String     @map("menu_item_id") @db.Uuid
  orderItemId String?    @map("order_item_id") @db.Uuid
  quantity    Int
  notes       String?
