datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. IDENTITY, ACCESS & SECURITY GROUP
// ==========================================

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  pinHash      String?     @map("pin_hash") // 4-digit POS cashier PIN (hashed)
  firstName    String      @map("first_name")
  lastName     String      @map("last_name")
  phone        String?
  mfaEnabled   Boolean     @default(false) @map("mfa_enabled")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  createdBy    String?     @map("created_by")
  updatedBy    String?     @map("updated_by")
  userRoles    UserRole[]
  sessions     Session[]
  auditLogs    AuditLog[]
  notifications Notification[]
  quickLinks   UserQuickLink[]
  orders       Order[]

  @@map("users")
}

model UserQuickLink {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  label     String
  href      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_quick_links")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique // SUPER_ADMIN, OUTLET_MANAGER, CASHIER, KITCHEN_USER, MENU_ADMIN, INVENTORY_USER, FINANCE_USER, AUDITOR
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  createdBy       String?          @map("created_by")
  updatedBy       String?          @map("updated_by")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  action          String           @unique // e.g. "order.create", "menu.86.toggle", "payment.refund"
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  outletId  String?  @map("outlet_id") // Nullable: NULL = Organization-wide grant, Non-NULL = Scoped to specific outlet
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  outlet    Outlet?  @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  outletId     String   @map("outlet_id") // Outlet context of current shift/session
  tokenHash    String   @unique @map("token_hash") // Hashed refresh token
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  lastSeenAt   DateTime? @map("last_seen_at") // touched by /waiters/heartbeat for live floor tracking
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet       Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AuditLog {
  id             String   @id @default(uuid())
  outletId       String   @map("outlet_id")
  userId         String   @map("user_id")
  approverUserId String?  @map("approver_user_id") // Populated on Manager Elevation Override
  action         String   // e.g. "ORDER_VOID", "DISCOUNT_APPLIED", "PRICE_OVERRIDE", "86_TOGGLED"
  entityType     String   @map("entity_type") // ORDER, PAYMENT, MENU_ITEM, STOCK
  entityId       String   @map("entity_id")
  beforeState    Json?    @map("before_state")
  afterState     Json?    @map("after_state")
  reasonCode     String?  @map("reason_code")
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")
  outlet         Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Notification {
  id         String   @id @default(uuid())
  outletId   String   @map("outlet_id")
  userId     String?  @map("user_id") // null = broadcast to whole outlet
  type       String   // e.g. "LEAKAGE_ALERT", "PO_APPROVAL_NEEDED", "SYNC_FAILED"
  title      String
  message    String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")
  outlet     Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ==========================================
// 2. ORGANIZATION & OUTLET STRUCTURE
// ==========================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  taxNumber   String?  @map("tax_number") // Organization-wide GSTIN
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")
  outlets     Outlet[]

  @@map("organizations")
}

model Outlet {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  name           String
  code           String         @unique // e.g. "BLR-01", "HYD-02"
  address        String?
  fssaiNumber    String?        @map("fssai_number")
  upiVpa         String?        @map("upi_vpa") // Real settlement VPA printed on receipts
  timezone       String         @default("Asia/Kolkata")
  currency       String         @default("INR")
  dayStartTime   String         @default("06:00") @map("day_start_time") // Business day boundary (DEC-013)
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  createdBy      String?        @map("created_by")
  updatedBy      String?        @map("updated_by")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  terminals      Terminal[]
  stations       Station[]
  diningTables   DiningTable[]
  userRoles      UserRole[]
  sessions       Session[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  businessHours  BusinessHours[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  modifierGroups ModifierGroup[]
  modifierOptions ModifierOption[]
  itemAvailabilities ItemAvailability[]
  discounts      Discount[]
  orders         Order[]
  orderSequences OrderSequence[]
  orderItems     OrderItem[]
  orderStatusHistories OrderStatusHistory[]
  payments       Payment[]
  invoices       Invoice[]
  kotTickets     KOTTicket[]
  customers      Customer[]
  loyaltyTransactions LoyaltyTransaction[]
  marketingCampaigns MarketingCampaign[]
  channelAccounts ChannelAccount[]
  ingredients    Ingredient[]
  recipes        Recipe[]
  stockMovements StockMovement[]
  vendors        Vendor[]
  purchaseOrders PurchaseOrder[]
  goodsReceivedNotes GoodsReceivedNote[]
  refunds        Refund[]
  ledgerEntries  LedgerEntry[]

  @@map("outlets")
}

model DiningTable {
  id          String   @id @default(uuid())
  outletId    String   @map("outlet_id")
  tableNumber String   @map("table_number") // e.g. "T-01", "T-12"
  capacity    Int      @default(4)
  section     String?  // e.g. "Indoor AC", "Terrace", "Bar"
  status      String   @default("VACANT") // VACANT, OCCUPIED, BILLING, DIRTY
  isActive    Boolean  @default(true) @map("is_active")
  posX        Int?     @map("pos_x")
  posY        Int?     @map("pos_y")
  currentOrderId String? @map("current_order_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orders      Order[]  @relation("TableOrders")
  currentOrder Order?  @relation("TableCurrentOrder", fields: [currentOrderId], references: [id])

  @@unique([outletId, tableNumber])
  @@map("dining_tables")
}

model Station {
  id        String   @id @default(uuid())
  outletId  String   @map("outlet_id")
  name      String   // e.g. "GRILL", "FRYER", "PANTRY", "BAR", "BAKERY"
  printerIp String?  @map("printer_ip") // Network IP for ESC/POS LAN printing (DEC-006)
  slaWarningSeconds Int @default(600) @map("sla_warning_seconds") // KDS ticket age turns amber past this
  slaBreachSeconds  Int @default(900) @map("sla_breach_seconds")  // KDS ticket age turns red/pulses past this
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]
  kotTickets KOTTicket[]

  @@map("stations")
}

model Terminal {
  id             String   @id @default(uuid())
  outletId       String   @map("outlet_id")
  name           String   // e.g. "Main Cashier Counter 1"
  terminalNumber String   @map("terminal_number") // "T-01"
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")
  outlet         Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, terminalNumber])
  @@map("terminals")
}

model BusinessHours {
  id        String   @id @default(uuid())
  outletId  String   @map("outlet_id")
  dayOfWeek Int      @map("day_of_week") // 0-6 (Sunday to Saturday)
  openTime  String   @map("open_time")   // e.g. "07:00"
  closeTime String   @map("close_time")  // e.g. "02:00"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, dayOfWeek])
  @@map("business_hours")
}

// ==========================================
// 3. MENU & CATALOG GROUP
// ==========================================

model MenuCategory {
  id          String     @id @default(uuid())
  outletId    String     @map("outlet_id")
  name        String     // e.g. "Biryani (Veg)", "Chinese Starters", "Cold Beverage"
  description String?
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  outlet      Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  menuItems   MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id             String           @id @default(uuid())
  outletId       String           @map("outlet_id")
  categoryId     String           @map("category_id")
  stationId      String?          @map("station_id")
  name           String
  onlineDisplayName String?       @map("online_display_name") // Overrides `name` on aggregator channels if set
  description    String?
  price          BigInt           // Minor units (paise/cents)
  isVeg          Boolean          @default(true) @map("is_veg")
  taxRate        Decimal          @default(5.0) @map("tax_rate") // 5% inclusive GST (DEC-004)
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  outlet         Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)
  category       MenuCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  station        Station?         @relation(fields: [stationId], references: [id])
  modifiers      MenuItemModifierGroup[]
  availabilities ItemAvailability[]
  orderItems     OrderItem[]
  kotItems       KOTItem[]
  channelItemMappings ChannelItemMapping[]
  recipes        Recipe[]

  @@map("menu_items")
}

model ModifierGroup {
  id          String           @id @default(uuid())
  outletId    String           @map("outlet_id")
  name        String           // e.g. "Choose Crust", "Spice Level", "Add-on Dips"
  minSelect   Int              @default(0) @map("min_select") // 1 = Mandatory, 0 = Optional
  maxSelect   Int              @default(1) @map("max_select")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  outlet      Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)
  options     ModifierOption[]
  menuItems   MenuItemModifierGroup[]

  @@map("modifier_groups")
}

model ModifierOption {
  id              String           @id @default(uuid())
  outletId        String           @map("outlet_id")
  modifierGroupId String           @map("modifier_group_id")
  name            String           // e.g. "Cheese Burst", "Extra Spicy", "Mint Chutney"
  price           BigInt           // Extra cost in minor units (paise)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  outlet          Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup    @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  selectedModifiers OrderItemModifier[]

  @@map("modifier_options")
}

model MenuItemModifierGroup {
  menuItemId      String        @map("menu_item_id")
  modifierGroupId String        @map("modifier_group_id")
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
  @@map("menu_item_modifier_groups")
}

model ItemAvailability {
  id         String   @id @default(uuid())
  outletId   String   @map("outlet_id")
  menuItemId String   @map("menu_item_id")
  isStocked  Boolean  @default(true) @map("is_stocked") // Real-time 86-listing flag
  stockQty   Int      @default(0) @map("stock_qty")
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt @map("updated_at")
  outlet     Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([outletId, menuItemId])
  @@map("item_availabilities")
}

// ==========================================
// 4. ORDERS & DISCOUNTS GROUP
// ==========================================

model Discount {
  id             String          @id @default(uuid())
  outletId       String          @map("outlet_id")
  name           String          // e.g. "Happy Hour 10%", "Flat 50 OFF"
  discountType   String          @map("discount_type") // PERCENTAGE, FLAT_AMOUNT
  value          BigInt          // Percentage points * 100 or Minor unit amount
  maxDiscount    BigInt?         @map("max_discount")
  minOrderValue  BigInt?         @map("min_order_value")
  requiresAuth   Boolean         @default(false) @map("requires_auth") // Needs Manager elevation if > 15% (DEC-008)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  outlet         Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orderDiscounts OrderDiscount[]
  campaigns      MarketingCampaign[]

  @@map("discounts")
}

// Gapless per-outlet-per-day order numbering. One row per (outlet, day);
// nextOrderNumber() atomically increments lastNumber via an upsert so two
// concurrent checkouts can never collide or skip.
model OrderSequence {
  outletId   String   @map("outlet_id")
  dateKey    String   @map("date_key") // "YYYY-MM-DD" in the outlet's timezone
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at")
  outlet     Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@id([outletId, dateKey])
  @@map("order_sequences")
}

model Order {
  id             String               @id // Client-generated UUIDv7
  outletId       String               @map("outlet_id")
  terminalNumber String               @map("terminal_number")
  orderNumber    String               @map("order_number") // Local daily sequence (e.g. #042)
  orderType      String               @default("DINE_IN") @map("order_type") // DINE_IN, TAKEAWAY, DELIVERY, AGGREGATOR
  diningTableId  String?              @map("dining_table_id")
  status         String               // CREATED, CONFIRMED, IN_KITCHEN, READY, DELIVERED, SETTLED, CANCELLED, VOIDED
  subtotal       BigInt               // Minor units
  discountTotal  BigInt               @default(0) @map("discount_total")
  taxTotal       BigInt               @map("tax_total") // 5% GST inclusive
  tipTotal       BigInt               @default(0) @map("tip_total")
  serviceChargeTotal BigInt           @default(0) @map("service_charge_total")
  grandTotal     BigInt               @map("grand_total")
  idempotencyKey String               @unique @map("idempotency_key")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  outlet         Outlet               @relation(fields: [outletId], references: [id], onDelete: Cascade)
  diningTable    DiningTable?         @relation("TableOrders", fields: [diningTableId], references: [id])
  currentForTables DiningTable[]      @relation("TableCurrentOrder")
  orderItems     OrderItem[]
  orderDiscounts OrderDiscount[]
  statusHistory  OrderStatusHistory[]
  payments       Payment[]
  invoices       Invoice[]
  customerId     String?              @map("customer_id")
  customer       Customer?            @relation(fields: [customerId], references: [id])
  loyaltyTransactions LoyaltyTransaction[]
  channelOrderMapping ChannelOrderMapping?
  waiterId       String?              @map("waiter_id")
  waiter         User?                @relation(fields: [waiterId], references: [id])
  kotTickets     KOTTicket[]

  @@unique([outletId, orderNumber])
  @@map("orders")
}

model OrderItem {
  id         String              @id @default(uuid())
  outletId   String              @map("outlet_id")
  orderId    String              @map("order_id")
  menuItemId String              @map("menu_item_id")
  quantity   Int
  unitPrice  BigInt              @map("unit_price")
  subtotal   BigInt
  notes      String?
  isVoided   Boolean             @default(false) @map("is_voided")
  voidReason String?             @map("void_reason")
  voidedBy   String?             @map("voided_by")
  course     String?             // STARTER, MAIN, DESSERT, BEVERAGE — course-wise firing tag
  seatNumber Int?                @map("seat_number") // for split-by-seat billing
  outlet     Outlet              @relation(fields: [outletId], references: [id], onDelete: Cascade)
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem            @relation(fields: [menuItemId], references: [id])
  modifiers  OrderItemModifier[]

  @@map("order_items")
}

model OrderItemModifier {
  orderItemId      String         @map("order_item_id")
  modifierOptionId String         @map("modifier_option_id")
  price            BigInt         // Cost at capture time in minor units
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOption   ModifierOption @relation(fields: [modifierOptionId], references: [id])

  @@id([orderItemId, modifierOptionId])
  @@map("order_item_modifiers")
}

model OrderDiscount {
  orderId    String   @map("order_id")
  discountId String   @map("discount_id")
  amount     BigInt   // Actual discount applied in minor units
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discount   Discount @relation(fields: [discountId], references: [id])

  @@id([orderId, discountId])
  @@map("order_discounts")
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  outletId  String   @map("outlet_id")
  orderId   String   @map("order_id")
  status    String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

// ==========================================
// 5. BILLING, PAYMENTS & LEDGER GROUP
// ==========================================

model Payment {
  id            String   @id @default(uuid())
  outletId      String   @map("outlet_id")
  orderId       String   @map("order_id")
  amount        BigInt   // Minor units
  method        String   // CASH, CARD, UPI, SPLIT
  status        String   // CAPTURED, REFUNDED, FAILED
  transactionId String?  @map("transaction_id") // Gateway or EDC Ref
  seatNumber    Int?     @map("seat_number") // set when this payment settles one seat of a split bill
  createdAt     DateTime @default(now()) @map("created_at")
  outlet        Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds       Refund[]

  @@map("payments")
}

model Invoice {
  id              String   @id @default(uuid())
  outletId        String   @map("outlet_id")
  orderId         String   @map("order_id")
  invoiceNo       String   @unique @map("invoice_no") // Sequential statutory tax invoice #
  amount          BigInt
  taxAmount       BigInt   @map("tax_amount") // CGST + SGST breakdown
  reprintCount    Int      @default(0) @map("reprint_count")
  waivedOffMinor  BigInt   @default(0) @map("waived_off_minor")
  waivedOffReason String?  @map("waived_off_reason")
  createdAt       DateTime @default(now()) @map("created_at")
  outlet          Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Refund {
  id              String   @id @default(uuid())
  outletId        String   @map("outlet_id")
  paymentId       String   @map("payment_id")
  amount          BigInt
  status          String   @default("SUCCESS") // SUCCESS, FAILED
  reasonCode      String   @map("reason_code")
  isPartial       Boolean  @default(false) @map("is_partial")
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       String?  @map("created_by")
  outlet          Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  payment         Payment  @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

model LedgerEntry {
  id             String    @id @default(uuid())
  outletId       String    @map("outlet_id")
  sourceType     String    @map("source_type") // ORDER, PAYMENT, REFUND, SETTLEMENT
  sourceId       String    @map("source_id")
  account        String    // Chart of Accounts code (DEC-013)
  debitMinor     BigInt    @default(0) @map("debit_minor")
  creditMinor    BigInt    @default(0) @map("credit_minor")
  externalRef    String?   @map("external_ref") // Tally / ERP voucher number
  status         String    @default("PENDING") // PENDING, POSTED, FAILED
  createdAt      DateTime  @default(now()) @map("created_at")
  postedAt       DateTime? @map("posted_at")
  outlet         Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@map("ledger_entries")
}

// ==========================================
// 6. KITCHEN ORCHESTRATION (KOT) GROUP
// ==========================================

model KOTTicket {
  id             String             @id @default(uuid())
  outletId       String             @map("outlet_id")
  orderId        String             @map("order_id")
  stationId      String?            @map("station_id")
  ticketNumber   String             @map("ticket_number") // Local sequence (e.g. KOT-012)
  status         String             // QUEUED, PREPARING, READY, SERVED
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  servedAt       DateTime?          @map("served_at")
  outlet         Outlet             @relation(fields: [outletId], references: [id], onDelete: Cascade)
  station        Station?           @relation(fields: [stationId], references: [id])
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kotItems       KOTItem[]
  statusHistory  KOTStatusHistory[]

  @@map("kot_tickets")
}

model KOTItem {
  id          String    @id @default(uuid())
  kotTicketId String    @map("kot_ticket_id")
  menuItemId  String    @map("menu_item_id")
  quantity    Int
  notes       String?
  course      String?   // STARTER, MAIN, DESSERT, BEVERAGE — carried from OrderItem.course
  servedAt    DateTime? @map("served_at")
  kotTicket   KOTTicket @relation(fields: [kotTicketId], references: [id], onDelete: Cascade)
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id])

  @@map("kot_items")
}

model KOTStatusHistory {
  id          String    @id @default(uuid())
  kotTicketId String    @map("kot_ticket_id")
  status      String    // includes CANCELLED, MODIFIED, SHIFTED for leakage tracking
  reasonCode  String?   @map("reason_code")
  createdAt   DateTime  @default(now()) @map("created_at")
  kotTicket   KOTTicket @relation(fields: [kotTicketId], references: [id], onDelete: Cascade)

  @@map("kot_status_history")
}

// ==========================================
// 7. CRM & LOYALTY GROUP
// ==========================================

model Customer {
  id                  String               @id @default(uuid())
  outletId            String               @map("outlet_id")
  firstName           String               @map("first_name")
  lastName            String?              @map("last_name")
  phone               String               @unique
  email               String?
  loyaltyPoints       Int                  @default(0) @map("loyalty_points") // DEC-014
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  outlet              Outlet               @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  campaignRecipients  CampaignRecipient[]

  @@map("customers")
}

model MarketingCampaign {
  id             String              @id @default(uuid())
  outletId       String              @map("outlet_id")
  name           String
  triggerType    String              @map("trigger_type") // MANUAL, INACTIVE_CUSTOMER, BIRTHDAY
  segmentFilter  Json?               @map("segment_filter") // e.g. {"inactiveDays": 30}
  discountId     String?             @map("discount_id")
  messageTemplate String             @map("message_template")
  status         String              @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  createdBy      String?             @map("created_by")
  outlet         Outlet              @relation(fields: [outletId], references: [id], onDelete: Cascade)
  discount       Discount?           @relation(fields: [discountId], references: [id])
  recipients     CampaignRecipient[]

  @@map("marketing_campaigns")
}

model CampaignRecipient {
  id          String            @id @default(uuid())
  campaignId  String            @map("campaign_id")
  customerId  String            @map("customer_id")
  status      String            @default("PENDING") // PENDING, SENT, FAILED — real delivery needs an SMS/push gateway not wired in this repo
  queuedAt    DateTime          @default(now()) @map("queued_at")
  sentAt      DateTime?         @map("sent_at")
  campaign    MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@map("campaign_recipients")
}

model LoyaltyTransaction {
  id             String   @id @default(uuid())
  outletId       String   @map("outlet_id")
  customerId     String   @map("customer_id")
  orderId        String   @map("order_id")
  pointsEarned   Int      @map("points_earned")
  pointsRedeemed Int      @map("points_redeemed")
  createdAt      DateTime @default(now()) @map("created_at")
  outlet         Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("loyalty_transactions")
}

// ==========================================
// 8. INTEGRATION HUB GROUP (Swiggy / Zomato)
// ==========================================

model ChannelAccount {
  id               String               @id @default(uuid())
  outletId         String               @map("outlet_id")
  channel          String               // SWIGGY, ZOMATO, ONDC
  externalOutletId String               @map("external_outlet_id")
  status           String               @default("ACTIVE") // ACTIVE, PAUSED, REVOKED
  credentialsRef   String?              @map("credentials_ref")
  apiKeyEncrypted    String?            @map("api_key_encrypted") // AES-256-GCM ciphertext, never returned to clients in plaintext
  apiSecretEncrypted String?            @map("api_secret_encrypted")
  connectedAt        DateTime?          @map("connected_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  outlet           Outlet               @relation(fields: [outletId], references: [id], onDelete: Cascade)
  itemMappings     ChannelItemMapping[]
  orderMappings    ChannelOrderMapping[]
  inboundEvents    InboundEvent[]
  outboundEvents   OutboundEvent[]
  syncJobs         SyncJob[]
  integrationErrors IntegrationError[]

  @@unique([outletId, channel])
  @@map("channel_accounts")
}

model ChannelItemMapping {
  id               String         @id @default(uuid())
  channelAccountId String         @map("channel_account_id")
  menuItemId       String         @map("menu_item_id")
  externalItemId   String         @map("external_item_id")
  channelPrice     BigInt?        @map("channel_price")
  isAvailable      Boolean        @default(true) @map("is_available") // Per-channel on/off toggle (Swiggy/Zomato)
  syncStatus       String         @default("SYNCED") @map("sync_status")
  version          Int            @default(1)
  updatedAt        DateTime       @updatedAt @map("updated_at")
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  menuItem         MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, menuItemId])
  @@unique([channelAccountId, externalItemId])
  @@map("channel_item_mapping")
}

model ChannelOrderMapping {
  id                 String         @id @default(uuid())
  channelAccountId   String         @map("channel_account_id")
  orderId            String         @unique @map("order_id")
  externalOrderId    String         @map("external_order_id")
  partnerStatedTotal BigInt         @map("partner_stated_total")
  computedTotal      BigInt         @map("computed_total")
  createdAt          DateTime       @default(now()) @map("created_at")
  channelAccount     ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, externalOrderId])
  @@map("channel_order_mapping")
}

model InboundEvent {
  id               String         @id @default(uuid())
  channelAccountId String         @map("channel_account_id")
  externalEventId  String         @map("external_event_id") // Idempotency guard
  eventType        String         @map("event_type") // ORDER_PLACED, CANCELLED
  rawPayload       Json           @map("raw_payload")
  status           String         @default("PROCESSED") // RECEIVED, PROCESSED, QUARANTINED
  receivedAt       DateTime       @default(now()) @map("received_at")
  processedAt      DateTime?      @map("processed_at")
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, externalEventId])
  @@map("inbound_events")
}

model OutboundEvent {
  id               String         @id @default(uuid())
  channelAccountId String         @map("channel_account_id")
  eventType        String         @map("event_type") // MENU_SYNC, 86_UPDATE
  payload          Json
  status           String         @default("QUEUED")
  createdAt        DateTime       @default(now()) @map("created_at")
  sentAt           DateTime?      @map("sent_at")
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@map("outbound_events")
}

model SyncJob {
  id               String         @id @default(uuid())
  channelAccountId String         @map("channel_account_id")
  jobType          String         @map("job_type")
  status           String         @default("SYNCHRONIZED")
  attempt          Int            @default(0)
  scheduledAt      DateTime       @default(now()) @map("scheduled_at")
  completedAt      DateTime?      @map("completed_at")
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@map("sync_jobs")
}

model IntegrationError {
  id               String         @id @default(uuid())
  channelAccountId String         @map("channel_account_id")
  source           String
  sourceId         String?        @map("source_id")
  errorCode        String         @map("error_code")
  message          String
  isResolved       Boolean        @default(false) @map("is_resolved")
  createdAt        DateTime       @default(now()) @map("created_at")
  resolvedAt       DateTime?      @map("resolved_at")
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@map("integration_errors")
}

// ==========================================
// 9. INVENTORY, RECIPE & VENDOR PROCUREMENT (R2)
// ==========================================

model Ingredient {
  id            String            @id @default(uuid())
  outletId      String            @map("outlet_id")
  name          String            // e.g. "Basmati Rice", "Paneer", "Cooking Oil"
  unitOfMeasure String            @map("unit_of_measure") // kg, g, l, ml, pcs
  currentStock  Decimal           @default(0) @map("current_stock")
  reorderLevel  Decimal           @default(0) @map("reorder_level")
  unitCost      BigInt            @default(0) @map("unit_cost") // Minor units per base unit
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  outlet        Outlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  recipeLines   RecipeIngredient[]
  stockMovements StockMovement[]
  poItems       PurchaseOrderItem[]
  grnItems      GoodsReceivedNoteItem[]

  @@map("ingredients")
}

model Recipe {
  id           String              @id @default(uuid())
  outletId     String              @map("outlet_id")
  menuItemId   String              @map("menu_item_id")
  version      Int                 @default(1)
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  outlet       Outlet              @relation(fields: [outletId], references: [id], onDelete: Cascade)
  menuItem     MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredients  RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id           String     @id @default(uuid())
  recipeId     String     @map("recipe_id")
  ingredientId String     @map("ingredient_id")
  quantity     Decimal    // e.g. 0.250 kg per portion
  yieldPercent Decimal    @default(100) @map("yield_percent")
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model StockMovement {
  id            String     @id @default(uuid())
  outletId      String     @map("outlet_id")
  ingredientId  String     @map("ingredient_id")
  movementType  String     @map("movement_type") // CONSUMPTION, RECEIPT, WASTAGE, ADJUSTMENT, TRANSFER
  quantity      Decimal    // Signed (+/-)
  referenceType String?    @map("reference_type") // ORDER, PURCHASE_ORDER, MANUAL, GRN
  referenceId   String?    @map("reference_id")
  reasonCode    String?    @map("reason_code") // e.g. "SPOILAGE", "PREP_WASTE"
  createdAt     DateTime   @default(now()) @map("created_at")
  createdBy     String?    @map("created_by")
  outlet        Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("stock_movements")
}

model Vendor {
  id             String          @id @default(uuid())
  outletId       String          @map("outlet_id")
  name           String          // e.g. "Metro Cash & Carry", "Dairy Fresh"
  contactPerson  String?         @map("contact_person")
  phone          String
  email          String?
  taxNumber      String?         @map("tax_number") // GSTIN
  paymentTerms   String?         @map("payment_terms") // e.g. "NET_30"
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  outlet         Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  goodsReceivedNotes GoodsReceivedNote[]

  @@map("vendors")
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  outletId       String              @map("outlet_id")
  vendorId       String              @map("vendor_id")
  poNumber       String              @unique @map("po_number") // e.g. "PO-2026-0042"
  status         String              @default("DRAFT") // DRAFT, APPROVED, SENT, PARTIALLY_RECEIVED, COMPLETED, CANCELLED
  totalAmount    BigInt              @map("total_amount")
  approvedBy     String?             @map("approved_by") // Tier 1-3 Approver (DEC-015)
  approvedAt     DateTime?           @map("approved_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  outlet         Outlet              @relation(fields: [outletId], references: [id], onDelete: Cascade)
  vendor         Vendor              @relation(fields: [vendorId], references: [id])
  poItems        PurchaseOrderItem[]
  goodsReceivedNotes GoodsReceivedNote[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  ingredientId    String        @map("ingredient_id")
  quantity        Decimal
  unitCost        BigInt        @map("unit_cost")
  totalCost       BigInt        @map("total_cost")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])

  @@map("purchase_order_items")
}

model GoodsReceivedNote {
  id              String                  @id @default(uuid())
  outletId        String                  @map("outlet_id")
  purchaseOrderId String?                 @map("purchase_order_id")
  vendorId        String                  @map("vendor_id")
  grnNumber       String                  @unique @map("grn_number") // e.g. "GRN-2026-0038"
  invoiceNumber   String?                 @map("invoice_number") // Vendor Invoice Ref
  receivedDate    DateTime                @default(now()) @map("received_date")
  status          String                  @default("VERIFIED") // PENDING, VERIFIED, VARIANCE_FLAGGED (DEC-016)
  createdAt       DateTime                @default(now()) @map("created_at")
  outlet          Outlet                  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id])
  vendor          Vendor                  @relation(fields: [vendorId], references: [id])
  grnItems        GoodsReceivedNoteItem[]

  @@map("goods_received_notes")
}

model GoodsReceivedNoteItem {
  id                  String            @id @default(uuid())
  goodsReceivedNoteId String            @map("goods_received_note_id")
  ingredientId        String            @map("ingredient_id")
  orderedQuantity     Decimal           @map("ordered_quantity")
  receivedQuantity    Decimal           @map("received_quantity")
  unitCost            BigInt            @map("unit_cost")
  goodsReceivedNote   GoodsReceivedNote @relation(fields: [goodsReceivedNoteId], references: [id], onDelete: Cascade)
  ingredient          Ingredient        @relation(fields: [ingredientId], references: [id])

  @@map("goods_received_note_items")
}
